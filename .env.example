# Sincronização em Nuvem (Supabase) — Obrigatório para sincronização entre dispositivos
# Use a publishable/anon key — NUNCA a service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<publishable-or-anon-key>

# Provedores de IA (Google Gemini & Groq Cloud) — OPCIONAL NO .ENV
# O aplicativo adota o modelo BYOK (Bring Your Own Key): cada usuário pode cadastrar
# suas próprias chaves gratuitas diretamente na tela de Configurações do app,
# que são salvas no cofre criptografado do dispositivo (expo-secure-store).
# As variáveis abaixo servem apenas como fallback de conveniência durante desenvolvimento local:
# EXPO_PUBLIC_GEMINI_API_KEY=sua_chave_do_google_ai_studio_aqui
# EXPO_PUBLIC_GROQ_API_KEY=sua_chave_da_groq_cloud_aqui
