# Copie para `.env` e preencha. Variáveis EXPO_PUBLIC_* são embutidas no bundle (públicas).
# Provedores de IA (Google Gemini & Groq Cloud)
EXPO_PUBLIC_GEMINI_API_KEY=sua_chave_do_google_ai_studio_aqui
EXPO_PUBLIC_GROQ_API_KEY=sua_chave_da_groq_cloud_aqui

# Sincronização em Nuvem (Supabase)
# Use a publishable/anon key — NUNCA a service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<publishable-or-anon-key>
