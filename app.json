{
  "expo": {
    "name": "Fit-Tracker",
    "slug": "Fit-Tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fittracker",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#10141a",
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "dark"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#10141a",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "userInterfaceStyle": "dark"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#10141a"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10141a",
          "image": "./assets/images/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/images/icon.png",
            "backgroundColor": "#10141a"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}