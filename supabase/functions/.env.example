# Server-only secrets. Configure with Supabase secrets; never prefix with EXPO_PUBLIC_.
GEMINI_API_KEY=replace-on-server
GROQ_API_KEY=replace-on-server
# Set a model available to your provider account.
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=qwen/qwen3.8-27b
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by the runtime.
